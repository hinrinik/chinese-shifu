rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validate document size and structure on write
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
            'imported', 'srs', 'classWords', 'streak', 'dailyReviews', 'updatedAt'
           ])
        // Prevent excessively large documents
        && request.resource.data.srs.size() <= 2000
        && request.resource.data.classWords.size() <= 1000
        && request.resource.data.imported.size() <= 200;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
