rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Validate document size and structure on write
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
            'imported', 'srs', 'classWords', 'streak', 'dailyReviews', 'updatedAt'
           ])
        // Prevent excessively large documents
        && request.resource.data.srs.size() <= 2000
        && request.resource.data.classWords.size() <= 1000
        && request.resource.data.imported.size() <= 200;
    }

    // Grandfather-father-son recovery snapshots (daily/weekly/monthly), same owner-only access.
    match /users/{userId}/snapshots/{slot} {
      allow read: if request.auth != null
        && request.auth.uid == userId
        && slot in ['daily', 'weekly', 'monthly'];

      allow write: if request.auth != null
        && request.auth.uid == userId
        && slot in ['daily', 'weekly', 'monthly']
        && request.resource.data.keys().hasOnly(['data', 'savedAt'])
        && request.resource.data.data.keys().hasOnly(
             ['imported', 'srs', 'classWords', 'streak', 'dailyReviews']
           )
        && request.resource.data.data.srs.size() <= 2000
        && request.resource.data.data.classWords.size() <= 1000
        && request.resource.data.data.imported.size() <= 200;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
